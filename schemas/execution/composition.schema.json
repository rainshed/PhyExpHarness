{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phyexp:execution-composition:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "infrastructureVersion", "id", "framework", "dshVersion", "profileDigest", "adapter", "dependencies", "plugins", "recipeDigest", "agentEntry", "runnerImage"],
  "properties": {
    "schemaVersion": {"const": 2},
    "kind": {"const": "plugin-composition"},
    "infrastructureVersion": {"const": "isolated-v2"},
    "id": {"$ref": "#/$defs/digest"},
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "resolved", "integrity"],
      "properties": {
        "package": {"const": "@deepseek-ai/dsh-sdk-minimal"},
        "version": {"type": "string", "minLength": 1},
        "resolved": {"type": "string", "pattern": "^https://"},
        "integrity": {"type": "string", "minLength": 1}
      }
    },
    "dshVersion": {"type": "string", "minLength": 1},
    "profileDigest": {"type": ["string", "null"]},
    "adapter": {"$ref": "#/$defs/digest"},
    "dependencies": {"$ref": "#/$defs/digest"},
    "recipeDigest": {"$ref": "#/$defs/digest"},
    "agentEntry": {"const": "src.execution.adapters.quantum_harbor.agent:DeepSeekHarborAgent"},
    "runnerImage": {"type": "string", "pattern": "^phyexp-runner:[0-9a-f]{16}$"},
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "object", "config"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "version": {"type": "string", "minLength": 1},
          "object": {"$ref": "#/$defs/digest"},
          "config": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
