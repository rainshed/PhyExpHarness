{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phyexp:contracts:v1",
  "$defs": {
    "ResourcePlanSettings": {
      "type": "object",
      "required": [
        "parallelism",
        "closeoutReserveSeconds",
        "closeoutReserveTokens"
      ],
      "properties": {
        "parallelism": {
          "type": "integer",
          "minimum": 1
        },
        "closeoutReserveSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "closeoutReserveTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ResourcePlanUpdate": {
      "type": "object",
      "required": [
        "changes",
        "reason",
        "expectedPlanRevision",
        "idempotencyKey"
      ],
      "properties": {
        "changes": {
          "$ref": "#/$defs/ResourcePlanSettings"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "expectedPlanRevision": {
          "type": "integer",
          "minimum": 0
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "AdmissionDecision": {
      "type": "object",
      "required": [
        "status",
        "requestId"
      ],
      "properties": {
        "status": {
          "enum": [
            "granted",
            "waiting",
            "denied"
          ]
        },
        "requestId": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "boundary": {
          "type": "string"
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 1
        },
        "userLimitsRevision": {
          "type": "integer"
        },
        "resourcePlanRevision": {
          "type": "integer"
        },
        "observed": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "Campaign": {
      "type": "object",
      "required": [
        "id",
        "solver",
        "meta",
        "limits",
        "state",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "solver": {
          "type": "object"
        },
        "meta": {
          "type": "object"
        },
        "limits": {
          "$ref": "#/$defs/RunLimits"
        },
        "state": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "selectionDecisionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "KnowledgePack": {
      "type": "object",
      "required": [
        "id",
        "dshVersion",
        "profileDigest",
        "documents"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "dshVersion": {
          "type": "string"
        },
        "profileDigest": {
          "type": "string"
        },
        "documents": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "PluginVersion": {
      "type": "object",
      "required": [
        "schemaVersion",
        "name",
        "version",
        "entry",
        "purpose",
        "configSchema",
        "dependencies",
        "observes",
        "intervenes",
        "capabilities",
        "fallbackBehavior",
        "assets"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "configSchema": {
          "type": "object"
        },
        "dependencies": {
          "type": "array"
        },
        "observes": {
          "type": "array"
        },
        "intervenes": {
          "type": "array"
        },
        "capabilities": {
          "type": "array"
        },
        "fallbackBehavior": {
          "type": "string"
        },
        "assets": {
          "type": "array"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "description": "Concise user-facing Chinese name; optional for legacy plugins."
        },
        "functionSummary": {
          "type": "string",
          "minLength": 1,
          "description": "Plain Chinese explanation of capabilities, when they act, and limitations. Intended function, not a claim of verified effectiveness."
        },
        "mechanism": {
          "type": "string",
          "minLength": 1,
          "description": "Explain how this plugin acts: e.g. advisory system context, callable tool, automatic check, or a combination. State whether it advises, executes or enforces; do not overclaim."
        }
      },
      "additionalProperties": true
    },
    "Candidate": {
      "type": "object",
      "required": [
        "id",
        "bundleDigest",
        "recipe",
        "plugins"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "bundleDigest": {
          "type": "string"
        },
        "recipe": {
          "type": "object"
        },
        "plugins": {
          "type": "array"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "taskEvaluation": {
          "$ref": "#/$defs/TaskEvaluation"
        }
      },
      "additionalProperties": true
    },
    "Batch": {
      "type": "object",
      "required": [
        "id",
        "campaignId",
        "candidateId",
        "idempotencyKey",
        "trials",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "campaignId": {
          "type": "string"
        },
        "candidateId": {
          "type": "string"
        },
        "idempotencyKey": {
          "type": "string"
        },
        "trials": {
          "type": "array"
        },
        "state": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "Trial": {
      "type": "object",
      "required": [
        "id",
        "batchId",
        "launchId",
        "state",
        "score",
        "usage"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "batchId": {
          "type": "string"
        },
        "launchId": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "usage": {
          "type": "object"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Failure"
            },
            {
              "type": "null"
            }
          ]
        },
        "taskAssessment": {
          "$ref": "#/$defs/TaskAssessment"
        }
      },
      "additionalProperties": true
    },
    "Usage": {
      "type": "object",
      "required": [
        "id",
        "purpose",
        "status",
        "confirmedTokens",
        "reservedTokens"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "confirmedTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reservedTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "Evidence": {
      "type": "object",
      "required": [
        "id",
        "sha256",
        "kind",
        "access",
        "trialId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "access": {
          "type": "string"
        },
        "trialId": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "Report": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "facts",
        "analysis",
        "evidenceRefs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "facts": {
          "type": "object"
        },
        "analysis": {
          "type": "object"
        },
        "evidenceRefs": {
          "type": "array"
        },
        "taskEvaluation": {
          "$ref": "#/$defs/TaskEvaluation"
        }
      },
      "additionalProperties": true
    },
    "Export": {
      "type": "object",
      "required": [
        "id",
        "candidateId",
        "bundleDigest",
        "archiveDigest",
        "checks"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "candidateId": {
          "type": "string"
        },
        "bundleDigest": {
          "type": "string"
        },
        "archiveDigest": {
          "type": "string"
        },
        "checks": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "RunLimits": {
      "type": "object",
      "required": [
        "wallTimeSeconds",
        "concurrency"
      ],
      "properties": {
        "maxRounds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maxTrials": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "trialTimeSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "softTokenLimit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "wallTimeSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "Failure": {
      "type": "object",
      "required": [
        "schemaVersion",
        "code",
        "stage",
        "message",
        "source"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "code": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "observed": {
          "type": "object",
          "properties": {
            "responseContentBytes": {
              "type": "integer",
              "minimum": 0
            },
            "responseBytesMeaning": {
              "const": "model-content-not-wire"
            },
            "transport": {
              "type": "object",
              "properties": {
                "version": {
                  "const": "model-transport-v1"
                },
                "actualTransport": {
                  "enum": ["websocket", "sse", "http", null]
                },
                "protocolStarted": {
                  "type": ["boolean", "null"]
                },
                "connectionId": {
                  "type": "string"
                },
                "closeCode": {
                  "type": "integer"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "limits": {
          "type": "object"
        },
        "scoringStatus": {
          "enum": [
            "pending",
            "not_run",
            "failed",
            "completed",
            "unknown"
          ]
        }
      },
      "additionalProperties": true
    },
    "SelectionDecision": {
      "type": "object",
      "required": [
        "id",
        "campaignId",
        "candidateId",
        "bundleId",
        "previousCandidateId",
        "previousDecisionId",
        "createdAt",
        "source",
        "rule",
        "reason",
        "tradeoffs",
        "limitations",
        "reconsiderWhen",
        "evidenceRefs",
        "verifiedEvidence",
        "assessment",
        "usage",
        "counts",
        "context"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "campaignId": {
          "type": "string"
        },
        "candidateId": {
          "type": "string"
        },
        "bundleId": {
          "type": "string"
        },
        "previousCandidateId": {
          "type": [
            "string",
            "null"
          ]
        },
        "previousDecisionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "number"
        },
        "source": {
          "const": "meta-analysis"
        },
        "rule": {
          "const": "meta-selection-v1"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "tradeoffs": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "reconsiderWhen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "verifiedEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "sha256",
              "trialId",
              "kind"
            ]
          }
        },
        "assessment": {
          "type": "object",
          "required": [
            "rule",
            "source",
            "certification",
            "reference",
            "candidate",
            "comparisonLimitations",
            "trials"
          ],
          "properties": {
            "certification": {
              "const": "not_certified"
            },
            "comparisonLimitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "usage": {
          "type": "object"
        },
        "counts": {
          "type": "object"
        },
        "context": {
          "type": "object",
          "required": [
            "campaignRevision",
            "state",
            "deadline",
            "remainingSeconds",
            "limits"
          ]
        }
      },
      "additionalProperties": true
    },
    "TaskAssessment": {
      "type": "object",
      "required": [
        "rule",
        "category",
        "score",
        "included",
        "reason",
        "basis",
        "label"
      ],
      "properties": {
        "rule": {
          "enum": ["task-completion-v1", "task-completion-v2", "task-completion-v3", "task-completion-v4"]
        },
        "category": {
          "enum": [
            "passed",
            "failed",
            "external_failure",
            "not_started",
            "cancelled",
            "pending",
            "unresolved"
          ]
        },
        "score": {
          "enum": [
            0,
            1,
            null
          ]
        },
        "included": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "basis": {
          "enum": [
            "rule",
            "official_score"
          ]
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "TaskEvaluation": {
      "type": "object",
      "required": [
        "rule",
        "total",
        "byTask",
        "macroSuccessRate",
        "taskCount",
        "coveredTasks"
      ],
      "properties": {
        "rule": {
          "enum": ["task-completion-v1", "task-completion-v2", "task-completion-v3", "task-completion-v4"]
        },
        "total": {
          "type": "object"
        },
        "byTask": {
          "type": "object"
        },
        "macroSuccessRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "taskCount": {
          "type": "integer",
          "minimum": 0
        },
        "coveredTasks": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "MetaComposition": {
      "type": "object",
      "required": [
        "id",
        "version",
        "preset",
        "plugins",
        "runnerImage",
        "lockSha256",
        "stopPolicy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "const": "meta-composition-v1"
        },
        "stopPolicy": {
          "enum": ["stop-review-v1", "goal-or-budget-v1"]
        },
        "preset": {
          "type": "string"
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "scope",
              "module",
              "enabled",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "scope": {
                "enum": [
                  "host",
                  "meta",
                  "reviewer"
                ]
              },
              "module": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "config": {
                "type": "object"
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "provides": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "runnerImage": {
          "type": "string"
        },
        "lockSha256": {
          "type": "string"
        }
      }
    },
    "StopReview": {
      "type": "object",
      "required": [
        "id",
        "campaignId",
        "sessionId",
        "policy",
        "request",
        "snapshotSha256",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "campaignId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "childId": {
          "type": "string"
        },
        "policy": {
          "const": "stop-review-v1"
        },
        "request": {
          "type": "object"
        },
        "snapshotSha256": {
          "type": "string"
        },
        "state": {
          "enum": [
            "pending",
            "approved",
            "continue",
            "insufficient_evidence",
            "failed",
            "consumed"
          ]
        },
        "result": {
          "type": [
            "object",
            "null"
          ]
        },
        "usage": {
          "type": "object"
        }
      }
    }
  }
}
