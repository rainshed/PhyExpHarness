    "kind": {
      "enum": [
        "motivation",
        "observation",
        "turning_point",
        "annotation"
      ],
      "type": "string"
    },
    "state": {
      "enum": [
        "proposed",
        "testing",
        "supported",
        "inconclusive",
        "failed",
        "abandoned"
      ],
      "type": "string"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "problem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "change": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "validation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "observations": {
      "type": "array",
