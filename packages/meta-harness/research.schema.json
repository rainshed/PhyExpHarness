                "maxLength": 100
              },
              "pluginKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "candidateId",
              "pluginKey"
            ],
            "additionalProperties": false
          },
          "trialId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "loaded": {
            "enum": [
              "yes",
              "no",
              "unknown"
            ],
            "type": "string"
          },
          "applicable": {
            "enum": [
              "yes",
              "no",
              "unknown"
            ],
            "type": "string"
          },
          "triggered": {
            "enum": [
              "yes",
              "no",
              "unknown"
            ],
            "type": "string"
          },
          "behavior": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
