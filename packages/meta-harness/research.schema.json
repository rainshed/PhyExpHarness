                },
                "supports": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                }
              },
              "required": [
                "evidenceId",
                "sha256",
                "start",
                "end",
                "unit",
                "supports"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
