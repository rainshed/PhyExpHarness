{
  "version": "meta-tools-v10",
  "operations": {
    "campaign_status": {
      "plugin": "campaign",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "write": false,
      "description": "Read current objective, fixed models, budgets and state.  Returns a compact receipt with a complete immutable file path; use native read/grep/bash for contents."
    },
    "campaign_plan_update": {
      "plugin": "campaign",
      "input": {
        "type": "object",
        "properties": {
          "changes": {
            "type": "object",
            "properties": {
              "parallelism": {
                "type": "integer"
              },
              "closeoutReserveSeconds": {
                "type": "integer"
              }
            },
            "required": [
              "parallelism",
              "closeoutReserveSeconds"
            ],
            "additionalProperties": false
          },
          "reason": {
            "type": "string"
          },
          "expectedPlanRevision": {
            "type": "integer"
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Stable identity for this write. Reuse the same key and arguments after an unknown outcome; reconcile campaign_status requests before creating another write."
          }
        },
        "required": [
          "changes",
          "reason",
          "expectedPlanRevision",
          "idempotencyKey"
        ],
        "additionalProperties": false
      },
      "write": true,
      "description": "Submit the initial resource plan to admit H0, or update future parallelism and closeout time. Read resourcePlanning in campaign_status for user limits and expectedPlanRevision. Benchmark task times are fixed. Token accounting and token budgets are unavailable."
    },
    "campaign_finish": {
      "plugin": "campaign",
      "input": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Why you have decided to end this activity."
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Your summary of this activity: work performed, results and conclusions, unresolved issues and limitations. Free-form text."
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Stable identity for this write. Reuse the same key and arguments after an unknown outcome; reconcile campaign_status requests before creating another write."
          }
        },
        "required": [
          "reason",
          "summary",
          "idempotencyKey"
        ],
        "additionalProperties": false
      },
      "write": true,
      "description": "End exploration by submitting your reason and activity summary. You decide when to finish according to the user objective. No stability rule, score, candidate, evidence list or separate report is required. Acceptance saves your decision and closes new experiments; existing work settles within its original limits. No further reply is needed. Ending is not platform certification of success."
    },
    "candidate_check": {
      "plugin": "experiments",
      "input": {
        "type": "object",
        "properties": {
          "plugins": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "config": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "path",
                "config"
              ],
              "additionalProperties": false
            }
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Stable identity for this write. Reuse the same key and arguments after an unknown outcome; reconcile campaign_status requests before creating another write."
          },
          "projectPath": {
            "type": "string",
            "description": "Complete Harness project directory under /work/plugins, containing harness.json. Entry, dependencies, profile and strategies are candidate-owned."
          }
        },
        "required": [
          "idempotencyKey"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "projectPath"
            ]
          },
          {
            "required": [
              "plugins"
            ]
          }
        ]
      },
      "write": true,
      "description": "Build and check a complete Harness project. projectPath uses the same operation as legacy plugin selection. Build failures return files. Does not launch a Trial."
    },
    "candidate_freeze": {
      "plugin": "experiments",
      "input": {
        "type": "object",
        "properties": {
          "plugins": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "config": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "path",
                "config"
              ],
              "additionalProperties": false
            }
          },
          "parent": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Stable identity for this write. Reuse the same key and arguments after an unknown outcome; reconcile campaign_status requests before creating another write."
          },
          "researchRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "recordId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "recordId",
                "revision"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "projectPath": {
            "type": "string",
            "description": "Complete Harness project directory under /work/plugins, containing harness.json. Entry, dependencies, profile and strategies are candidate-owned."
          }
        },
        "required": [
          "description",
          "idempotencyKey"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "projectPath"
            ]
          },
          {
            "required": [
              "plugins"
            ]
          }
        ]
      },
      "write": true,
      "description": "Build and freeze a complete Harness project. projectPath uses the same operation as legacy plugin selection. Build failures return files. Does not launch a Trial."
    },
    "candidate_list": {
      "plugin": "experiments",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "write": false,
      "description": "List frozen candidates.  Returns a compact receipt with a complete immutable file path; use native read/grep/bash for contents."
    },
    "candidate_diff": {
      "plugin": "experiments",
      "input": {
        "type": "object",
        "properties": {
          "left": {
            "type": "string"
          },
          "right": {
            "type": "string"
          }
        },
        "required": [
          "left",
          "right"
        ],
        "additionalProperties": false
      },
      "write": false,
      "description": "Compare two frozen plugin combinations in this Campaign."
    },
    "batch_submit": {
      "plugin": "experiments",
      "input": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repeats": {
            "type": "integer"
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Stable identity for this write. Reuse the same key and arguments after an unknown outcome; reconcile campaign_status requests before creating another write."
          }
        },
        "required": [
          "candidateId",
          "tasks",
          "repeats",
          "idempotencyKey"
        ],
        "additionalProperties": false
      },
      "write": true,
      "description": "Submit one candidate, task list and repeat count. "
    },
    "batch_status": {
      "plugin": "experiments",
      "input": {
        "type": "object",
        "properties": {
          "batchId": {
            "type": "string"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "batchId"
        ],
        "additionalProperties": false
      },
      "write": false,
      "description": "Read batch status and paginated Trials, including official result and evidence references."
    },
    "results_compare": {
      "plugin": "experiments",
      "input": {
        "type": "object",
        "properties": {
          "candidateIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "batchIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "write": false,
      "description": "Read unified backend evaluation of all attempts in the selected scope, including limitations. Returns a compact receipt with a complete immutable file path; use native read/grep/bash for contents."
    },
    "candidate_retain": {
      "plugin": "experiments",
      "input": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tradeoffs": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reconsiderWhen": {
            "type": "string"
          },
          "expectedSelectionRevision": {
            "type": "integer"
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Stable identity for this write. Reuse the same key and arguments after an unknown outcome; reconcile campaign_status requests before creating another write."
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "candidateId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "maxItems": 100
                }
              },
              "required": [
                "candidateId",
                "reason",
                "evidenceRefs"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "researchRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "recordId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "recordId",
                "revision"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
          }
        },
        "required": [
          "candidateId",
          "reason",
          "evidenceRefs",
          "tradeoffs",
          "limitations",
          "reconsiderWhen",
          "expectedSelectionRevision",
          "idempotencyKey",
          "summary",
          "alternatives",
          "researchRefs"
        ],
        "additionalProperties": false
      },
      "write": true,
      "description": "Select, reaffirm or roll back to a checked frozen candidate using all attempts and the backend taskEvaluation. Read expectedSelectionRevision from campaign_status.selectionRevision. Supply readable summary, alternatives considered, researchRefs, evidence and tradeoffs. Returns a compact receipt and immutable decision file."
    },
    "materials_list": {
      "plugin": "evidence",
      "input": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "candidateId": {
            "type": "string"
          },
          "batchId": {
            "type": "string"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "write": false,
      "description": "List allowed materials in this Campaign. "
    },
    "materials_search": {
      "plugin": "evidence",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "candidateId": {
            "type": "string"
          },
          "batchId": {
            "type": "string"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "write": false,
      "description": "Search allowed material text, including trajectories and past analyses. "
    },
    "materials_read": {
      "plugin": "evidence",
      "input": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "ref"
        ],
        "additionalProperties": false
      },
      "write": false,
      "description": "Read a preview with character offsets; returned file descriptor points to complete original content. Binary data is accessible by path."
    },
    "evidence_list": {
      "plugin": "evidence",
      "input": {
        "type": "object",
        "properties": {
          "batchId": {
            "type": "string"
          },
          "trialId": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "write": false,
      "description": "List allowed evidence and official results.  Returns a compact receipt with a complete immutable file path; use native read/grep/bash for contents."
    },
    "evidence_read": {
      "plugin": "evidence",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "write": false,
      "description": "Read an allowed evidence item. "
    },
    "sdk_search": {
      "plugin": "evidence",
