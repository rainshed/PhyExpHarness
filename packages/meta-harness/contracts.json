          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "write": false,
      "description": "Search version-matched execution plugin documentation. "
    },
    "sdk_read": {
      "plugin": "evidence",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "write": false,
      "description": "Read an indexed SDK document.  Returns a compact receipt with a complete immutable file path; use native read/grep/bash for contents."
    },
    "sdk_inspect": {
      "plugin": "evidence",
      "input": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "write": false,
      "description": "Inspect a public execution API declaration. "
    },
    "report_get_facts": {
      "plugin": "reporting",
      "input": {
        "type": "object",
        "properties": {
          "batchId": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "write": false,
      "description": "Freeze a content-addressed report fact snapshot. Return its ID and readable path."
    },
    "report_save": {
      "plugin": "reporting",
      "input": {
        "type": "object",
        "properties": {
          "factsId": {
            "type": "string"
          },
          "analysis": {
            "$ref": "meta-report-analysis-v1"
          },
          "analysisFile": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "expectedReportRevision": {
            "type": "integer"
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Stable identity for this write. Reuse the same key and arguments after an unknown outcome; reconcile campaign_status requests before creating another write."
          }
        },
        "required": [
          "factsId",
          "expectedReportRevision",
          "idempotencyKey"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "analysis"
            ],
            "not": {
              "required": [
                "analysisFile"
              ]
            }
          },
          {
            "required": [
              "analysisFile"
            ],
            "not": {
              "required": [
                "analysis"
              ]
            }
          }
        ]
      },
      "write": true,
      "description": "Append an analysis revision against the factsId from report_get_facts. Supply exactly one of analysis or analysisFile; prefer a JSON file under /work/analysis with SHA-256. Read the schema/template and current revision from the facts result; use expectedReportRevision=0 for a new report. brief is a separate readable conclusion; researchRefs must belong to that facts snapshot. Each round and the final report have independent revisions. Corrections require a new idempotencyKey."
    },
    "report_get": {
      "plugin": "reporting",
      "input": {
        "type": "object",
        "properties": {
          "reportId": {
            "type": "string"
          }
        },
        "required": [
          "reportId"
        ],
        "additionalProperties": false
      },
      "write": false,
      "description": "Read an immutable report revision and its fact/analysis paths."
    },
    "export_create": {
      "plugin": "reporting",
      "input": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Stable identity for this write. Reuse the same key and arguments after an unknown outcome; reconcile campaign_status requests before creating another write."
          }
        },
        "required": [
          "candidateId",
          "idempotencyKey"
        ],
        "additionalProperties": false
      },
      "write": true,
      "description": "Export an existing frozen candidate. "
    },
    "export_status": {
      "plugin": "reporting",
      "input": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string"
          }
        },
        "required": [
          "operationId"
        ],
        "additionalProperties": false
      },
      "write": false,
      "description": "Read an export operation and validation status; never resubmit on a lost response."
    },
    "research_save": {
      "plugin": "reporting",
      "write": true,
      "description": "Save a human-readable research attempt, observation, turning point or sourced historical annotation. Independent summary first; unknown is not no. Immutable revisions; create expectedRevision=0. No candidate required.",
      "input": {
        "type": "object",
        "properties": {
          "recordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "record": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "motivation",
                  "observation",
                  "turning_point",
                  "annotation"
                ],
                "type": "string"
              },
              "state": {
                "enum": [
                  "proposed",
                  "testing",
                  "supported",
                  "inconclusive",
                  "failed",
                  "abandoned"
                ],
                "type": "string"
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "problem": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              },
              "hypothesis": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              },
              "change": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              },
              "validation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              },
              "observations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "plugin": {
                      "type": "object",
                      "properties": {
                        "candidateId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "pluginKey": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        }
                      },
                      "required": [
                        "candidateId",
                        "pluginKey"
                      ],
                      "additionalProperties": false
                    },
                    "trialId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "loaded": {
                      "enum": [
                        "yes",
                        "no",
                        "unknown"
                      ],
                      "type": "string"
                    },
                    "applicable": {
                      "enum": [
                        "yes",
                        "no",
                        "unknown"
                      ],
                      "type": "string"
                    },
                    "triggered": {
                      "enum": [
                        "yes",
                        "no",
                        "unknown"
                      ],
                      "type": "string"
                    },
                    "behavior": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16000
                    },
                    "benefit": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16000
                    },
                    "anchors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "evidenceId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "start": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "end": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "unit": {
                            "const": "characters",
                            "type": "string"
                          },
                          "supports": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1200
                          }
                        },
                        "required": [
                          "evidenceId",
                          "sha256",
                          "start",
                          "end",
                          "unit",
                          "supports"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 100
                    }
                  },
                  "required": [
                    "plugin",
                    "trialId",
                    "loaded",
                    "applicable",
                    "triggered",
                    "behavior",
                    "benefit",
                    "anchors"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 100
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                },
                "maxItems": 100
              },
              "nextStep": {
                "type": "string",
                "maxLength": 4000
              },
              "anchors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "evidenceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "unit": {
                      "const": "characters",
                      "type": "string"
                    },
                    "supports": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1200
                    }
                  },
                  "required": [
                    "evidenceId",
                    "sha256",
                    "start",
                    "end",
                    "unit",
                    "supports"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 100
              },
              "candidateIds": {
                "type": "array",
                "items": {
                  "type": "string",
