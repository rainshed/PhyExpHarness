{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "providers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adapter",
          "auth",
          "models"
        ],
        "properties": {
          "adapter": {
            "enum": [
              "pi-ai",
              "deepseek"
            ]
          },
          "auth": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "codex"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "env"
                ],
                "properties": {
                  "type": {
                    "const": "api-key"
                  },
                  "env": {
                    "type": "string",
                    "pattern": "^[A-Z_][A-Z0-9_]*$"
                  }
                }
              }
            ]
          },
          "baseURL": {
            "type": "string",
            "minLength": 1
          },
          "preflightURL": {
            "type": "string",
            "minLength": 1
          },
          "api": {
            "enum": [
              "openai-completions",
              "openai-responses",
              "anthropic-messages"
            ]
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "reasoningEfforts"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "reasoningEfforts": {
                  "anyOf": [
                    {
                      "const": false
                    },
                    {
                      "type": "object",
                      "minProperties": 1,
                      "propertyNames": {
                        "enum": [
                          "off",
                          "minimal",
                          "low",
                          "medium",
                          "high",
                          "xhigh",
                          "max"
                        ]
                      },
                      "additionalProperties": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  ]
                },
                "defaultReasoningEffort": {
                  "enum": [
                    "off",
                    "minimal",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                },
                "contextWindow": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxTokens": {
                  "type": "integer",
                  "minimum": 1
                },
                "input": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "text",
                      "image"
                    ]
                  }
                },
                "version": {
                  "type": "string"
                },
                "versionPolicy": {
                  "type": "string"
                },
                "compat": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "supportsStore": {
                      "type": "boolean"
                    },
                    "supportsDeveloperRole": {
                      "type": "boolean"
                    },
                    "supportsReasoningEffort": {
                      "type": "boolean"
                    },
                    "supportsUsageInStreaming": {
                      "type": "boolean"
                    },
                    "supportsFinishReason": {
                      "type": "boolean"
                    },
                    "requiresToolResultName": {
                      "type": "boolean"
                    },
                    "requiresAssistantAfterToolResult": {
                      "type": "boolean"
                    },
                    "requiresThinkingAsText": {
                      "type": "boolean"
                    },
                    "requiresReasoningContentOnAssistantMessages": {
                      "type": "boolean"
                    },
                    "supportsMaxOutputTokens": {
                      "type": "boolean"
                    },
                    "supportsStrictMode": {
                      "type": "boolean"
                    },
                    "supportsTemperature": {
                      "type": "boolean"
                    },
                    "forceAdaptiveThinking": {
                      "type": "boolean"
                    },
                    "allowEmptySignature": {
                      "type": "boolean"
                    },
                    "supportsStrictTools": {
                      "type": "boolean"
                    },
                    "maxTokensField": {
                      "enum": [
                        "max_tokens",
                        "max_completion_tokens"
                      ]
                    },
                    "thinkingFormat": {
                      "enum": [
                        "openai",
                        "deepseek",
                        "openrouter",
                        "together",
                        "baseten",
                        "zai",
                        "qwen",
                        "chat-template",
                        "qwen-chat-template",
                        "string-thinking",
                        "ant-ling"
                      ]
                    },
                    "cacheControlFormat": {
                      "enum": [
                        "anthropic"
                      ]
                    }
                  }
                }
              }
            }
          },
          "compat": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "supportsStore": {
                "type": "boolean"
              },
              "supportsDeveloperRole": {
                "type": "boolean"
              },
              "supportsReasoningEffort": {
                "type": "boolean"
              },
              "supportsUsageInStreaming": {
                "type": "boolean"
              },
              "supportsFinishReason": {
                "type": "boolean"
              },
              "requiresToolResultName": {
                "type": "boolean"
              },
              "requiresAssistantAfterToolResult": {
                "type": "boolean"
              },
              "requiresThinkingAsText": {
                "type": "boolean"
              },
              "requiresReasoningContentOnAssistantMessages": {
                "type": "boolean"
              },
              "supportsMaxOutputTokens": {
                "type": "boolean"
              },
              "supportsStrictMode": {
                "type": "boolean"
              },
              "supportsTemperature": {
                "type": "boolean"
              },
              "forceAdaptiveThinking": {
                "type": "boolean"
              },
              "allowEmptySignature": {
                "type": "boolean"
              },
              "supportsStrictTools": {
                "type": "boolean"
              },
              "maxTokensField": {
                "enum": [
                  "max_tokens",
                  "max_completion_tokens"
                ]
              },
              "thinkingFormat": {
                "enum": [
                  "openai",
                  "deepseek",
                  "openrouter",
                  "together",
                  "baseten",
                  "zai",
                  "qwen",
                  "chat-template",
                  "qwen-chat-template",
                  "string-thinking",
                  "ant-ling"
                ]
              },
              "cacheControlFormat": {
                "enum": [
                  "anthropic"
                ]
              }
            }
          },
          "transport": {
            "enum": [
              "auto",
              "sse",
              "websocket"
            ]
          }
        }
      }
    }
  }
}
