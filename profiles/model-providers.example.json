{
  "schemaVersion": 1,
  "providers": {
    "example-chat": {
      "adapter": "pi-ai",
      "api": "openai-completions",
      "baseURL": "https://gateway.example.com/v1",
      "auth": {"type": "api-key", "env": "EXAMPLE_MODEL_API_KEY"},
      "models": [
        {
          "id": "replace-with-chat-model-id",
          "name": "我的 Chat 模型",
          "contextWindow": 128000,
          "maxTokens": 8192,
          "reasoningEfforts": false
        }
      ]
    },
    "example-responses": {
      "adapter": "pi-ai",
      "api": "openai-responses",
      "baseURL": "https://gateway.example.com/v1",
      "auth": {"type": "api-key", "env": "EXAMPLE_MODEL_API_KEY"},
      "models": [
        {
          "id": "replace-with-responses-model-id",
          "name": "我的 Responses 模型",
          "contextWindow": 128000,
          "maxTokens": 8192,
          "reasoningEfforts": {"off": null, "high": "high"},
          "defaultReasoningEffort": "high"
        }
      ]
    },
    "example-messages": {
      "adapter": "pi-ai",
      "api": "anthropic-messages",
      "baseURL": "https://gateway.example.com",
      "auth": {"type": "api-key", "env": "EXAMPLE_MODEL_API_KEY"},
      "models": [
        {
          "id": "replace-with-messages-model-id",
          "name": "我的 Messages 模型",
          "contextWindow": 128000,
          "maxTokens": 8192,
          "reasoningEfforts": false
        }
      ]
    }
  }
}
